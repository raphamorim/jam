// std.collections — dynamic data structures.
//
// `Vec(T)` — growable dynamic array. Uses libc malloc / free /
// realloc as the backing allocator. MVS auto-drops the backing
// buffer at scope exit. A user-pluggable Allocator interface is
// deferred until function-pointer support lands in the compiler;
// once it does, `std.mem.Allocator` will be a runtime vtable type
// matching Zig's `std.mem.Allocator`.
//
// `Option(T)` lives in `std/option` and is imported here for
// fallible getters / poppers.

const { Option } = import("option");

pub extern fn malloc(size: u64) *mut[] u8;
pub extern fn free(ptr: *mut[] u8);
pub extern fn realloc(ptr: *mut[] u8, size: u64) *mut[] u8;

pub fn Vec(T: type) type {
    return struct {
        ptr: *mut[] T,
        length: u32,
        capacity: u32,

        // Construct an empty Vec. The initial capacity is *element-
        // size-aware* (Rust's RawVec heuristic): 8 slots for u8-
        // shaped types, 4 for medium types up to 1KB, 1 for larger
        // structs. Amortizes push cost for small T without blowing
        // memory on big T whose first push might be the only push.
        fn empty() Self {
            var s: u64 = @sizeOf(T);
            var cap: u32 = 1;
            if (s == 1) { cap = 8; }
            else if (s <= 1024) { cap = 4; }
            var bytes: u64 = (cap as u64) * s;
            var raw: *mut[] u8 = malloc(bytes);
            return Self { ptr: raw as *mut[] T, length: 0, capacity: cap };
        }

        // Pre-allocate `cap` slots up front. Useful when the caller
        // knows the final size — eliminates the log(N) regrowths.
        // cap=0 clamps to 1 to avoid malloc(0)'s implementation-
        // defined return.
        fn withCapacity(cap: u32) Self {
            var actualCap: u32 = cap;
            if (actualCap == 0) { actualCap = 1; }
            var bytes: u64 = (actualCap as u64) * @sizeOf(T);
            var raw: *mut[] u8 = malloc(bytes);
            return Self { ptr: raw as *mut[] T, length: 0, capacity: actualCap };
        }

        fn push(self: mut Self, value: T) {
            if (self.length == self.capacity) {
                self.grow();
            }
            self.ptr[self.length] = value;
            self.length = self.length + 1;
        }

        fn pop(self: mut Self) Option(T) {
            if (self.length == 0) {
                return Option(T).None();
            }
            self.length = self.length - 1;
            return Option(T).Some(self.ptr[self.length]);
        }

        fn len(self: Self) u32 { return self.length; }

        fn get(self: Self, i: u32) Option(T) {
            if (i >= self.length) {
                return Option(T).None();
            }
            return Option(T).Some(self.ptr[i]);
        }

        // Reset length to zero without releasing the buffer. Lets
        // callers reuse one Vec across many iterations of a hot
        // loop (per-frame audio drain, per-sector decode scratch)
        // and pay malloc exactly once, at construction.
        fn clear(self: mut Self) {
            self.length = 0;
        }

        // Shrink to `newLen`. No-op when `newLen >= length`, so
        // `truncate(0)` is the same as `clear()` and `truncate(N)`
        // is safe regardless of current length. Capacity is left
        // alone — Vec never shrinks its backing buffer.
        fn truncate(self: mut Self, newLen: u32) {
            if (newLen < self.length) {
                self.length = newLen;
            }
        }

        // Set length explicitly, clamped to `capacity`. The use
        // case is "I just filled the first N slots via `.ptr` (a
        // memcpy, an extern fill, a manual loop) and need the Vec
        // bookkeeping to reflect that." Callers who need room
        // first must `reserve` before writing.
        fn setLen(self: mut Self, newLen: u32) {
            if (newLen > self.capacity) {
                self.length = self.capacity;
            } else {
                self.length = newLen;
            }
        }

        // Ensure room for `additional` more elements beyond the
        // current length. Doubles capacity until the bound is hit,
        // then `realloc`s once — cheaper than letting `push` grow
        // log(N) times when the final size is roughly known. No-op
        // when the existing capacity already covers the request.
        fn reserve(self: mut Self, additional: u32) {
            var needed: u32 = self.length + additional;
            if (needed <= self.capacity) {
                return;
            }
            var newCap: u32 = self.capacity;
            while (newCap < needed) {
                newCap = newCap * 2;
            }
            var newBytes: u64 = (newCap as u64) * @sizeOf(T);
            self.ptr = realloc(self.ptr as *mut[] u8, newBytes) as *mut[] T;
            self.capacity = newCap;
        }

        // Bulk-append every element of `other`. One `reserve` up
        // front means the copy loop never re-grows; -O3 should
        // vectorize the loop for primitive element types. The
        // input is `[]T`, so a string literal slices into a
        // Vec(u8) and a `[N]T` array decays in the same call.
        fn appendSlice(self: mut Self, other: []T) {
            var n: u32 = other.len as u32;
            self.reserve(n);
            var i: u32 = 0;
            while (i < n) {
                self.ptr[self.length + i] = other.ptr[i];
                i = i + 1;
            }
            self.length = self.length + n;
        }

        // Internal grow: doubles capacity via `realloc`. realloc
        // tries to grow in place against allocator metadata first
        // (jemalloc / mimalloc / glibc all do this opportunistically
        // against adjacent free pages); falls back to a fresh
        // allocation + a single bulk memcpy of the live bytes + free
        // of the old buffer. Net: one libc call replacing our
        // previous element-by-element copy loop.
        fn grow(self: mut Self) {
            var newCap: u32 = self.capacity * 2;
            var newBytes: u64 = (newCap as u64) * @sizeOf(T);
            self.ptr = realloc(self.ptr as *mut[] u8, newBytes) as *mut[] T;
            self.capacity = newCap;
        }

        fn drop(self: mut Self) {
            free(self.ptr as *mut[] u8);
        }
    };
}
