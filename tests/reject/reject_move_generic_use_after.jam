// Ports "Move - use after method-call move rejected" in its ORIGINAL
// C++ shape: the receiver is a generic instantiation, and the analysis
// resolves push's `move` mode through the factory template's signature.
// expect-error: use of moved binding `c`

const { Vec } = import("std/collections");

const Counter = struct { value: u32, sink: *mut u32 };

cfn drop(self: mut Counter) {
    var p: *mut u32 = self.sink;
    p.* = p.* + 1;
}

fn bad(sink: *mut u32) u32 {
    var v: Vec(Counter) = Vec(Counter).empty();
    var c: Counter = Counter { value: 1, sink: sink };
    v.push(c);
    return c.value;
}

fn main() {}
