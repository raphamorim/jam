// Ported from C++ "Codegen - non-void fn that forgets to return is rejected"
// (tests/cpp/test_codegen_errors.cpp): a non-void function whose body
// may complete without returning a value is rejected at compile time.
// expect-error: fn `forgotReturn` has non-void return type but a path reaches the function end without returning a value

fn forgotReturn() i32 { var x: i32 = 42; }
fn main() i32 { return forgotReturn(); }
