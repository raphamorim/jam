// Ported from tests/cpp/test_codegen_errors.cpp "Clone - owns-resources
// without cfn clone rejected": a type with its own cfn drop but no cfn
// clone cannot be cloned — the compiler can clone structure, not
// resources.
// expect-error: `Counter` owns resources (it has `cfn drop`)
// expect-error: define `cfn clone(self: Self) Self`

const Counter = struct {
    value: u32,
    sink: *mut u32,
};

cfn drop(self: mut Counter) {
    var p: *mut u32 = self.sink;
    p.* = p.* + 1;
}

fn consume(c: move Counter) {
    var owned: Counter = c;
}

fn bad(sink: *mut u32) {
    var c: Counter = Counter { value: 1, sink: sink };
    var d: Counter = c.clone();
}
fn main() {}
