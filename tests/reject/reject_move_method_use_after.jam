// Ported from tests/cpp/test_codegen_errors.cpp "Move - use after
// method-call move rejected": method-call moves follow the same rules —
// the analysis resolves the callee through the receiver's static type.
// This pins the non-generic receiver shape; the original generic
// Vec(Counter).push shape lives in reject_move_generic_*.jam.
// expect-error: use of moved binding `c`

const Counter = struct {
    value: u32,
    sink: *mut u32,
};

cfn drop(self: mut Counter) {
    var p: *mut u32 = self.sink;
    p.* = p.* + 1;
}

const Bin = struct {
    dummy: u32,

    fn put(self: mut Self, value: move Counter) {
        var owned: Counter = value;
    }
};

fn bad(sink: *mut u32) u32 {
    var b: Bin = Bin { dummy: 0 };
    var c: Counter = Counter { value: 1, sink: sink };
    b.put(c);
    return c.value;
}
fn main() {}
