// Ported from tests/cpp/test_codegen_errors.cpp "Move - use after enum
// payload capture rejected": enum payload construction is a MOVE of
// bare drop-bearing args — the enum's tag-dispatched glue owns the drop.
// expect-error: use of moved binding `c`

const Counter = struct {
    value: u32,
    sink: *mut u32,
};

cfn drop(self: mut Counter) {
    var p: *mut u32 = self.sink;
    p.* = p.* + 1;
}

fn consume(c: move Counter) {
    var owned: Counter = c;
}

const Maybe = enum {
    None,
    Some(Counter),
};

fn bad(sink: *mut u32) u32 {
    var c: Counter = Counter { value: 1, sink: sink };
    var m: Maybe = Maybe.Some(c);
    return c.value;
}
fn main() {}
