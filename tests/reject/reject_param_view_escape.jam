// Return-value provenance: a slice returned by a call views the storage
// of the arguments it derives from (per the callee's return chains), so
// read-only-parameter storage cannot be written through `v.asSlice()`,
// a binding of it, a wrapper fn's result, a `mut` arg, or a `mut self`
// method — each escape hatch below is closed.
// expect-error: cannot write through `b` — it views elements of a read-only parameter
// expect-error: cannot write through `s` — it views elements of a read-only parameter
// expect-error: cannot write through `w` — it views elements of a read-only parameter
// expect-error: cannot pass `buf` as a `mut` argument
// expect-error: cannot call `mut self` method `push` through `v`
// expect-error: cannot call `mut self` method `push` through `h`
// expect-error: cannot write through `fb` — it views elements of a read-only parameter
// expect-error: cannot write through `p` — it views elements of a read-only parameter
// expect-error: cannot write through `sb` — it views elements of a read-only parameter
// expect-error: cannot write through `os` — it views elements of a read-only parameter
// expect-error: cannot write through `ob` — it views elements of a read-only parameter
// expect-error: cannot write through `rs` — it views elements of a read-only parameter
// expect-error: cannot write through `lp` — it views elements of a read-only parameter
// expect-error: cannot write through `lb` — it views elements of a read-only parameter

const { Vec } = import("std").collections;

fn pokeForEach(v: Vec(u8)) {
    for b in v.asSlice() {
        b = 0;
    }
}

fn pokeBound(v: Vec(u8)) {
    var s: []u8 = v.asSlice();
    s[0] = 1;
}

fn window(v: Vec(u8)) []u8 {
    return v.asSlice();
}

fn pokeTransitive(v: Vec(u8)) {
    var w: []u8 = window(v);
    w[0] = 1;
}

fn fill(out: mut []u8, b: u8) {
    for x in out {
        x = b;
    }
}

fn pokeViaMutArg(buf: []u8) {
    fill(buf, 0);
}

fn pokeViaMutMethod(v: Vec(u8)) {
    v.push(1);
}

const Holder = struct {
    tag: u32,
    buf: Vec(u8),
};

// Indirect receiver chains resolve too: the method is found through the
// typed field, and the write-root walks back to the parameter.
fn pokeFieldMethod(h: Holder) {
    h.buf.push(1);
}

fn pokeFieldView(h: Holder) {
    for fb in h.buf.asSlice() {
        fb = 0;
    }
}

const Pair = struct {
    data: []u8,
    n: u32,
};

fn wrap(v: Vec(u8)) Pair {
    return Pair { data: v.asSlice(), n: 0 };
}

// A returned struct's slice field views the argument; writes through it
// (bound or direct) are writes into the read-only parameter's tree.
fn pokeStructField(v: Vec(u8)) {
    var p: Pair = wrap(v);
    p.data[0] = 1;
}

fn pokeStructDirect(v: Vec(u8)) {
    for sb in wrap(v).data {
        sb = 0;
    }
}

const { Option } = import("std").option;
const { Result } = import("std").result;

const ViewResult = Result(str, u32);

fn firstView(v: Vec(u8)) Option([]u8) {
    return Option([]u8).Some(v.asSlice());
}

fn tryView(v: Vec(u8)) ViewResult {
    if (v.len() == 0) {
        return ViewResult.Err(0);
    }
    return ViewResult.Ok(v.asSlice());
}

// Enum payloads carry the view: matched bindings of a read-only-rooted
// scrutinee reject element writes (direct call, bound, and alias-ctor).
fn pokeOptionPayload(v: Vec(u8)) {
    match (firstView(v)) {
        Some(os) { os[0] = 1; }
        None     { }
    }
}

fn pokeBoundOption(v: Vec(u8)) {
    var o: Option([]u8) = firstView(v);
    match (o) {
        Some(s2) {
            for ob in s2 {
                ob = 0;
            }
        }
        None { }
    }
}

fn pokeResultAlias(v: Vec(u8)) {
    match (tryView(v)) {
        Ok(rs)  { rs[0] = 1; }
        Err(e2) { }
    }
}

// Locals assembled field-by-field (or conditionally) then returned carry
// the views of what was stored into them.
fn assemble(v: Vec(u8)) Pair {
    var ap: Pair = Pair { data: "", n: 0 };
    ap.data = v.asSlice();
    return ap;
}

fn pokeAssembled(v: Vec(u8)) {
    var lp: Pair = assemble(v);
    lp.data[0] = 1;
}

fn pickView(v: Vec(u8)) []u8 {
    var s3: []u8 = "";
    if (v.len() > 0) {
        s3 = v.asSlice();
    }
    return s3;
}

fn pokePicked(v: Vec(u8)) {
    for lb in pickView(v) {
        lb = 0;
    }
}

fn main() u8 {
    return 0;
}
