// Ported from tests/cpp/test_codegen_errors.cpp "Move - use after move
// rejected": a drop-bearing local read (via member access) after being
// moved into a `move` param. Complements reject_use_after_move.jam,
// which pins the plain-scalar bare-read shape.
// expect-error: use of moved binding `c`

const Counter = struct {
    value: u32,
    sink: *mut u32,
};

cfn drop(self: mut Counter) {
    var p: *mut u32 = self.sink;
    p.* = p.* + 1;
}

fn consume(c: move Counter) {
    var owned: Counter = c;
}

fn bad(sink: *mut u32) u32 {
    var c: Counter = Counter { value: 1, sink: sink };
    consume(c);
    return c.value;
}
fn main() {}
