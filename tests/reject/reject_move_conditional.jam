// Ported from tests/cpp/test_codegen_errors.cpp "Move - conditional move
// rejected": rustc would insert a runtime drop flag here; jam rejects,
// Swift SE-0390 style, keeping codegen flag-free.
// expect-error: is moved on some control-flow paths but not others
// expect-error: move it on all control-flow paths or none

const Counter = struct {
    value: u32,
    sink: *mut u32,
};

cfn drop(self: mut Counter) {
    var p: *mut u32 = self.sink;
    p.* = p.* + 1;
}

fn consume(c: move Counter) {
    var owned: Counter = c;
}

fn bad(sink: *mut u32, doIt: bool) {
    var c: Counter = Counter { value: 1, sink: sink };
    if (doIt) {
        consume(c);
    }
}
fn main() {}
