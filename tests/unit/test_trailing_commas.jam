// Trailing commas in call argument lists (struct literals always took
// them; calls used to be a parse error).
const { assert } = import("test");

extern fn labs(x: i64) i64;

fn add3(a: u64, b: u64, c: u64) u64 {
    return a + b + c;
}

tfn trailingCommaInCall() {
    assert(add3(1, 2, 3,) as i32, 6);
    const x: u64 = add3(
        10,
        20,
        30,
    );
    assert(x as i32, 60);
}

tfn trailingCommaInExternCall() {
    assert(labs(-5,) as i32, 5);
}

tfn trailingCommaInCallC() {
    assert(@callC(i64, labs as u64, -7 as i64,) as i32, 7);
}
