// Behavioural tests for the match → JirTag::Switch lowering path
// (astgen.cpp::collectSwitchCases / astgenMatch). Each `tfn` exercises
// either the Switch path (integer or unit-enum-variant arms, with or
// without a wildcard / or-pattern) or the legacy CondBr-chain
// fallback (ranges, payload bindings) — both must produce identical
// answers.
//
// The Switch path is also specialized at codegen time: a single
// non-wildcard case collapses to `icmp+cond_br` rather than emitting
// a real LLVM `switch`. These tests verify the runtime values stay
// correct under both shapes; the IR shape itself is a perf/readability
// concern checked separately via `--emit-ir`.

const { assert } = import("test");

// Path 1: dense integer arms → real LLVM switch

fn classifyDigit(x: u8) u8 {
    var r: u8 = 0;
    match (x) {
        0 { r = 100; }
        1 { r = 101; }
        2 { r = 102; }
        3 { r = 103; }
        _ { r = 200; }
    }
    return r;
}

tfn denseFirstArm()  { assert(classifyDigit(0), 100); }
tfn denseMiddleArm() { assert(classifyDigit(2), 102); }
tfn denseLastArm()   { assert(classifyDigit(3), 103); }
tfn denseDefault()   { assert(classifyDigit(99), 200); }

// Path 2: sparse integer arms

fn classifySparse(x: i32) i32 {
    var r: i32 = 0;
    match (x) {
        10  { r = 1; }
        500 { r = 2; }
        9999 { r = 3; }
        _    { r = 0; }
    }
    return r;
}

tfn sparseLow()      { assert(classifySparse(10),   1); }
tfn sparseMid()      { assert(classifySparse(500),  2); }
tfn sparseHigh()     { assert(classifySparse(9999), 3); }
tfn sparseDefault()  { assert(classifySparse(42),   0); }

// Path 3: signed negatives

fn classifySigned(x: i32) i32 {
    var r: i32 = 0;
    match (x) {
        -1 { r = 10; }
         0 { r = 20; }
         1 { r = 30; }
         _ { r = 99; }
    }
    return r;
}

tfn signedNegative() { assert(classifySigned(-1), 10); }
tfn signedZero()     { assert(classifySigned(0),  20); }
tfn signedPositive() { assert(classifySigned(1),  30); }
tfn signedDefault()  { assert(classifySigned(7),  99); }

// Path 4: single arm → cond_br specialization

fn singleArm(x: u32) u32 {
    var r: u32 = 0;
    match (x) {
        42 { r = 1; }
        _  { r = 0; }
    }
    return r;
}

tfn singleArmMatch()    { assert(singleArm(42) as i32, 1); }
tfn singleArmDefault()  { assert(singleArm(0)  as i32, 0); }
tfn singleArmMisses()   { assert(singleArm(99) as i32, 0); }

// Path 5: unit-enum variants → switch on i8 discriminant

const Light = enum { Red, Yellow, Green };

fn lightTime(l: Light) u32 {
    var t: u32 = 0;
    match (l) {
        Light.Red    { t = 30; }
        Light.Yellow { t = 5; }
        Light.Green  { t = 25; }
    }
    return t;
}

tfn lightRed()    { assert(lightTime(Light.Red)    as i32, 30); }
tfn lightYellow() { assert(lightTime(Light.Yellow) as i32, 5);  }
tfn lightGreen()  { assert(lightTime(Light.Green)  as i32, 25); }

// Path 6: or-pattern flattens to multiple switch cases

fn isWeekend(d: u8) u8 {
    var r: u8 = 0;
    match (d) {
        0 | 6 { r = 1; }
        _     { r = 0; }
    }
    return r;
}

tfn orSunday()   { assert(isWeekend(0), 1); }
tfn orSaturday() { assert(isWeekend(6), 1); }
tfn orMonday()   { assert(isWeekend(1), 0); }
tfn orFriday()   { assert(isWeekend(5), 0); }

// Path 7: shared target across or-pattern + per-literal arm

fn quadrant(x: i8) i8 {
    var r: i8 = 0;
    match (x) {
        1 | 2 { r = 10; }
        3 | 4 { r = 20; }
        _     { r = 0; }
    }
    return r;
}

tfn quad1() { assert(quadrant(1) as i32, 10); }
tfn quad2() { assert(quadrant(2) as i32, 10); }
tfn quad3() { assert(quadrant(3) as i32, 20); }
tfn quad4() { assert(quadrant(4) as i32, 20); }
tfn quad9() { assert(quadrant(9) as i32, 0);  }

// Path 8: fallback — range patterns stay on the CondBr chain

fn rangeClassify(x: u32) u32 {
    var r: u32 = 0;
    match (x) {
        0..=9    { r = 1; }
        10..=99  { r = 2; }
        _        { r = 3; }
    }
    return r;
}

tfn rangeLow()    { assert(rangeClassify(5)   as i32, 1); }
tfn rangeMid()    { assert(rangeClassify(50)  as i32, 2); }
tfn rangeHigh()   { assert(rangeClassify(500) as i32, 3); }
tfn rangeEdgeIn() { assert(rangeClassify(9)   as i32, 1); }
tfn rangeEdgeOut(){ assert(rangeClassify(10)  as i32, 2); }

// Path 9: fallback — payloaded enum variants with bindings

const Shape = enum {
    Point,
    Circle(u32),
    Rect(u32, u32),
};

fn area(s: Shape) u32 {
    var a: u32 = 0;
    match (s) {
        Shape.Point      { a = 0; }
        Shape.Circle(r)  { a = r * r * 3; }
        Shape.Rect(w, h) { a = w * h; }
    }
    return a;
}

tfn payloadPoint()  { assert(area(Shape.Point)         as i32, 0); }
tfn payloadCircle() { assert(area(Shape.Circle(5))     as i32, 75); }
tfn payloadRect()   { assert(area(Shape.Rect(4, 6))    as i32, 24); }

// Path 10: non-exhaustive integer match (no wildcard)

fn maybeMatch(x: u8) u8 {
    var r: u8 = 99;
    match (x) {
        1 { r = 10; }
        2 { r = 20; }
        3 { r = 30; }
    }
    return r;
}

tfn nonExhaustiveHit()  { assert(maybeMatch(2), 20); }
tfn nonExhaustiveMiss() { assert(maybeMatch(7), 99); }
