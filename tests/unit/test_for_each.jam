// `for v in iterable` — element walks over slices and arrays. The loop
// var binds each element in place (like `s[i]` as an lvalue), so writes
// through it land in the underlying storage. `start:end` walks are in
// test_for_bounds.jam.

const { assert } = import("test");
const { Vec } = import("std").collections;

tfn sliceBytes() {
    const s: str = "abc";
    var sum: u32 = 0;
    for b in s {
        sum = sum + (b as u32);
    }
    assert(sum, 294);   // 97+98+99
}

tfn arrayElements() {
    var arr: [4]u16 = [10, 20, 30, 40];
    var total: u32 = 0;
    for v in arr {
        total = total + (v as u32);
    }
    assert(total, 100);
}

tfn writesLandInStorage() {
    var arr: [4]u16 = [10, 20, 30, 40];
    for v in arr {
        v = v * 2;
    }
    assert(arr[0] as u32, 20);
    assert(arr[3] as u32, 80);
}

tfn subSliceExpression() {
    var arr: [4]u16 = [10, 20, 30, 40];
    var mid: u32 = 0;
    for v in arr[1..3] {
        mid = mid + (v as u32);
    }
    assert(mid, 50);   // 20+30
}

tfn breakAndContinue() {
    var n: u32 = 0;
    for b in "aXbXc" {
        if (b == 88) { continue; }   // 'X'
        if (b == 99) { break; }      // 'c'
        n = n + 1;
    }
    assert(n, 2);
}

const Point = struct {
    x: i32,
    y: i32,
};

tfn structElementsBindByref() {
    var pts: [2]Point = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    var acc: i32 = 0;
    for p in pts {
        acc = acc + p.x + p.y;
    }
    assert(acc, 10);
}

tfn vecThroughAsSlice() {
    var v: Vec(u8) = Vec(u8).empty();
    v.push(5);
    v.push(7);
    var sum: u32 = 0;
    for b in v.asSlice() {
        sum = sum + (b as u32);
    }
    assert(sum, 12);
}

tfn emptySliceNeverRuns() {
    const e: str = "";
    var ran: u32 = 0;
    for b in e {
        ran = 1;
    }
    assert(ran, 0);
}

tfn nestedWalks() {
    var grid: u32 = 0;
    for a in "ab" {
        for b in "cd" {
            grid = grid + 1;
        }
    }
    assert(grid, 4);
}

tfn loopVarShadowRestores() {
    var v: u32 = 99;
    for v in "ab" { }
    assert(v, 99);
}
