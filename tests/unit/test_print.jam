const { assert } = import("test");
const fmt = import("std").fmt;

// Smoke tests for the cfn print pipeline. The jam test-runner can't
// capture stdout to assert exact bytes (that's done in
// tests/cpp/test_print.cpp via subprocess + redirects); these tests
// just verify the pipeline compiles and runs without crashing for
// each supported value type.

fn callsPrintWithIntOK() i32 {
    var x: i32 = 42;
    fmt.print("x={x}\n");
    return 1;
}

fn callsPrintWithStrOK() i32 {
    var name: str = "Alice";
    fmt.print("hello {name}\n");
    return 1;
}

fn callsPrintWithBoolOK() i32 {
    var t: bool = true;
    fmt.print("t={t}\n");
    return 1;
}

fn callsEprintRoutesOK() i32 {
    var n: i32 = 7;
    fmt.eprint("err {n}\n");
    return 1;
}

fn callsEscapesOK() i32 {
    fmt.print("set is {{1,2}}\n");
    return 1;
}

tfn printIntCompiles() { assert(callsPrintWithIntOK(), 1); }
tfn printStrCompiles() { assert(callsPrintWithStrOK(), 1); }
tfn printBoolCompiles() { assert(callsPrintWithBoolOK(), 1); }
tfn eprintCompiles() { assert(callsEprintRoutesOK(), 1); }
tfn escapesCompile() { assert(callsEscapesOK(), 1); }

fn callsPrintlnOK() i32 {
    var n: u64 = 7;
    fmt.println("n = {n}");
    fmt.println("");
    fmt.eprintln("stderr line");
    return 1;
}

tfn printlnSmoke() {
    assert(callsPrintlnOK(), 1);
}
