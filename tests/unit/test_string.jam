// String literals and the str type ([]u8 slice).
const { assert } = import("test");
const { eq } = import("std").string;

tfn literalBasics() {
    const greeting: str = "Hello, world!";
    assert(greeting.len as i32, 13);
    assert(greeting[0] as i32, 72);    // H
    assert(greeting[12] as i32, 33);   // !
    const empty: str = "";
    assert(empty.len as i32, 0);
}

tfn utf8Literals() {
    // "世界" is six UTF-8 bytes; the emoji four more.
    const cjk: str = "世界";
    assert(cjk.len as i32, 6);
    const emoji: str = "🌍";
    assert(emoji.len as i32, 4);
}

fn echo(message: str) str {
    return message;
}

tfn stringsThroughCalls() {
    assert(eq(echo("pass me through"), "pass me through") as u8, 1);
}

tfn strIsU8Slice() {
    const text: str = "convert me";
    const bytes: []u8 = text;
    assert(bytes.len as i32, 10);
    assert(eq(bytes, text) as u8, 1);
}

tfn varStringsAssign() {
    var msg: str = "first";
    msg = "second";
    assert(eq(msg, "second") as u8, 1);
}
